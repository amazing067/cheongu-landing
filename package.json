{
  "name": "cheongu-landing",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-public.js && next dev -p 4000",
    "dev:turbo": "node scripts/prepare-public.js && next dev -p 4000 --turbo",
    "build": "node scripts/prepare-public.js && next build",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:all": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('.next');rm('node_modules/.cache');rm('.turbo');console.log('Removed .next, node_modules/.cache, .turbo')\"",
    "rebuild": "npm run clean && npm run build",
    "rebuild:clean": "npm run clean:all && npm run build",
    "start": "next start -p 4000",
    "build:tailwind-legacy": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/site.css --minify",
    "create-template": "node create-acroform-template.js create",
    "validate-template": "node create-acroform-template.js validate"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^2.0.1",
    "next": "15.4.11",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
